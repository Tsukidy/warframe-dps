{
  "name": "warframe-dps-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser frontend of warframe-dps (docs/architecture/frontend.md).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-i18n.mjs && node scripts/gen-mocks.mjs",
    "gen:check": "node scripts/gen-i18n.mjs --check",
    "predev": "npm run gen",
    "dev": "vite",
    "dev:mock": "npm run gen && vite --mode mock",
    "prebuild": "npm run gen",
    "build": "vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "prelint": "npm run gen",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run gen",
    "test": "vitest",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.28",
    "fuse.js": "7.5.0",
    "immer": "11.2.10",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-intl": "12.2.1",
    "recharts": "3.11.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.23.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-formatjs": "8.1.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
